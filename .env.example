# Токен Telegram-бота от @BotFather
BOT_TOKEN=123456789:AA-замени-на-свой-токен

# ID главного админа (твой Telegram user id). Можно не заполнять:
# тогда первый, кто нажмёт /start, автоматически станет главным админом.
# Узнать свой id можно у @userinfobot.
ADMIN_ID=

# Ключ шифрования базы (Fernet). Данные (суммы, категории, заметки, долги)
# хранятся в data.db зашифрованными. Сгенерировать свой ключ:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ВАЖНО: не потеряй ключ — без него расшифровать базу невозможно.
# Если оставить пустым — данные будут храниться без шифрования.
DB_KEY=

# Путь к файлу базы (по умолчанию data.db рядом с ботом)
# DB_PATH=/opt/traty-bot/data.db
