[Unit]
Description=Traty Bot — учёт личных трат в Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/traty-bot
EnvironmentFile=/opt/traty-bot/.env
ExecStart=/opt/traty-bot/venv/bin/python /opt/traty-bot/bot.py
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
